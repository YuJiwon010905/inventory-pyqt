-- order 목록
CREATE TABLE IF NOT EXISTS orders(
orderID INT PRIMARY KEY AUTO_INCREMENT,    -- 주문고유번호
-- clientID INT, -- 고객고유번호(accounts.userID)
-- 고객고유번호 대신 고객명으로 해도 되는지?
clientname VARCHAR(50),
-- itemID INT,   -- 주문물품고유번호(items.serialID)
-- 주문물품고유번호 대신 주문물품명으로 해도 되는지?
itemname VARCHAR(50),
num INT,      -- 주문수량
orderdate DATE,  -- 주문일자
FOREIGN KEY(clientname) REFERENCES accounts(name),
FOREIGN KEY(itemname) REFERENCES items(name)
);
