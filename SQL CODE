
CREATE DATABASE IF NOT EXISTS orderappdb  DEFAULT CHARACTER SET utf8mb4;
use orderappdb;

SET FOREIGN_KEY_CHECKS=0;
DROP TABLE IF EXISTS orders;
DROP TABLE IF EXISTS items;
DROP TABLE IF EXISTS accounts;
DROP TABLE IF EXISTS admins;
SET FOREIGN_KEY_CHECKS=1;

-- ITEM 목록
CREATE TABLE IF NOT EXISTS items(
serialID INT PRIMARY KEY AUTO_INCREMENT,
name VARCHAR(50) UNIQUE NOT NULL,
price INT,
stock INT
);

INSERT INTO items(name,price,stock)
VALUES('로티세리 바비큐 치킨',7600,30),("스테이크 앤 치즈",8000,30),("로스트 치킨",7300,30),
("써브웨이 클럽",6700,30),('피자썹',4500,30),('쉬림프',5500,30),('치킨 데리야끼',7900,30)
-- 가격 및 수량을 업데이트함. 그런데 이때 price 는 덮어쓰더라도
-- stock 을 원래 수량에서 더할수 있는 방법 없을까
ON DUPLICATE KEY UPDATE price=VALUES(price), stock=stock+VALUES(stock);


CREATE TABLE IF NOT EXISTS admins (
  id INT PRIMARY KEY AUTO_INCREMENT,
  adminname VARCHAR(50) UNIQUE NOT NULL,
  pw VARCHAR(100) NOT NULL
);

-- username key가 중복일 경우 에러 대신 업데이트를 실행합니다.
INSERT INTO admins (adminname, pw) VALUES ('admin', 'admin123')
ON DUPLICATE KEY UPDATE pw=VALUES(pw);



